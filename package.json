{
  "name": "industrialist-calculator",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\" && npm run format:check:tooling",
    "format:check:tooling": "prettier --check \"package.json\" \".github/workflows/quality.yml\" \"tools/*.mjs\" \"tools/design-rules-baseline.json\"",
    "test:persistence": "node --test --test-concurrency=1 tools/save-migration.test.mjs tools/persistence-storage.test.mjs tools/autosave-schema.test.mjs",
    "test:graph": "node --test --test-concurrency=1 tools/flow-store-history.test.mjs",
    "test:canvas": "node --test --test-concurrency=1 tools/pixi-canvas-adapter.test.mjs tools/canvas-renderer-preference.test.mjs",
    "test:layout": "node --test --test-concurrency=1 tools/layout-groups.test.mjs",
    "test:calculation": "node --test tools/calculation-validation.test.mjs && node --test tools/production-flow.test.mjs",
    "check:design-rules": "node tools/check-design-rules.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "driver.js": "^1.4.0",
    "elkjs": "^0.11.1",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "pixi.js": "8.22.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.1.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "serialize-javascript": "^7.1.3",
    "zod": "^4.6.6"
  }
}
